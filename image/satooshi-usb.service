[Unit]
Description=Satooshi Pro USB serial gadget (no networking or shell)
DefaultDependencies=no
Wants=systemd-remount-fs.service systemd-modules-load.service
After=systemd-remount-fs.service systemd-modules-load.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
StartLimitIntervalSec=180
StartLimitBurst=6

[Service]
Type=oneshot
ExecStart=/opt/satooshi/image/usb-gadget.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
TimeoutStartSec=45

[Install]
WantedBy=sysinit.target

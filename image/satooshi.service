[Unit]
Description=Satooshi Pro prototype device
DefaultDependencies=no
Wants=local-fs.target systemd-modules-load.service satooshi-usb.service satooshi-splash.service
After=local-fs.target systemd-modules-load.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
StartLimitIntervalSec=180
StartLimitBurst=30

[Service]
Type=simple
User=satooshi
Group=satooshi
SupplementaryGroups=gpio i2c dialout
WorkingDirectory=/opt/satooshi
Environment=PYTHONPATH=/opt/satooshi/vendor:/opt/satooshi/device
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m satooshi.main
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/satooshi
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes

[Install]
WantedBy=sysinit.target

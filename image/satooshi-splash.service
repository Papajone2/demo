[Unit]
Description=Satooshi early OLED logo (no keys or wallet access)
DefaultDependencies=no
Wants=systemd-modules-load.service
After=systemd-modules-load.service
RequiresMountsFor=/opt/satooshi/device
Before=sysinit.target satooshi.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
User=satooshi
Group=satooshi
SupplementaryGroups=i2c
Environment=PYTHONPATH=/opt/satooshi/device
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/sh -c 'if test -x /opt/satooshi/image/early-splash && /opt/satooshi/image/early-splash; then exit 0; fi; exec /usr/bin/python3 -m satooshi.splash'
TimeoutStartSec=8
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=sysinit.target

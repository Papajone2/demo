#!/bin/sh
set -eu
umask 077
# Open before permission/namespace setup, so failures there are not lost on
# a device without a text console. Reports export fixed markers only.
exec >>/run/wallet.log 2>&1
trap 'code=$?; if test "$code" -ne 0; then echo "SATOOSHI_BOOT stage=launcher_failed"; fi' EXIT
echo "SATOOSHI_BOOT stage=launcher_started"
test -f /run/storage-ready || { sleep 5; exit 1; }
# Bound retries to actual device nodes, never a guessed fixed boot delay.
tries=0
while ! test -c /dev/ttyGS0 || ! test -c /dev/i2c-1 || ! test -c /dev/gpiomem; do
  tries=$((tries + 1))
  test "$tries" -lt 100 || { echo "Device nodes unavailable" >/run/wallet-startup-error; sleep 2; exit 1; }
  sleep 0.05
done
chown 1000:1000 /dev/ttyGS0 /dev/i2c-1 /dev/gpiomem
chmod 600 /dev/ttyGS0 /dev/i2c-1 /dev/gpiomem
echo "SATOOSHI_BOOT stage=device_nodes_ready"
# Keep privilege dropping, filesystem isolation, no networking and private tmp.
/usr/bin/setpriv --reuid=1000 --regid=1000 --clear-groups --no-new-privs \
  /usr/bin/bwrap --unshare-user --unshare-pid --unshare-net --unshare-ipc \
  --unshare-uts --die-with-parent --new-session --cap-drop ALL \
  --ro-bind / / --proc /proc --dev /dev \
  --dev-bind /dev/ttyGS0 /dev/ttyGS0 --dev-bind /dev/i2c-1 /dev/i2c-1 \
  --dev-bind /dev/gpiomem /dev/gpiomem \
  --tmpfs /tmp --tmpfs /run --tmpfs /var --dir /var/lib \
  --bind /data/satooshi /var/lib/satooshi \
  --clearenv --setenv PATH /usr/bin:/bin \
  --setenv PYTHONPATH /opt/satooshi/device \
  --setenv PYTHONDONTWRITEBYTECODE 1 \
  --chdir /opt/satooshi /usr/bin/python3 -m satooshi.main
